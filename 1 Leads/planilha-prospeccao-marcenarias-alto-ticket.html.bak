\n\nIsso acontece quando o perfil ainda não foi verificado pelo dono. Além de deixar a empresa vulnerável, faz o Google não mostrar vocês no topo pra quem pesquisa por móveis planejados aqui perto.\n\nA gente trabalha organizando a presença de marcenarias aqui na cidade. Se você quiser que a gente te ajude a verificar e deixar o perfil 100% oficial com fotos boas dos móveis, me dá um toque por aqui.", "status_crm": "Novo Lead", "notas": "Ficha não reivindicada no Maps. Contato direto celular (15) 99778-7394."}];
    const STORAGE_KEY = 'vocacao_crm_marcenarias_v1';

    let leads = [];
    let currentCategory = 'todos';
    let currentStatusFilter = 'todos';
    let currentView = 'table';

    function initCRM() {
        const stored = localStorage.getItem(STORAGE_KEY);
        if (stored) {
            try {
                const savedData = JSON.parse(stored);
                leads = INITIAL_LEADS.map(initLead => {
                    const match = savedData.find(s => s.id === initLead.id);
                    if (match) {
                        return {
                            ...initLead,
                            status_crm: match.status_crm || initLead.status_crm,
                            notas: match.notas !== undefined ? match.notas : initLead.notas
                        };
                    }
                    return initLead;
                });
            } catch(e) {
                leads = [...INITIAL_LEADS];
            }
        } else {
            leads = [...INITIAL_LEADS];
        }
        renderViews();
    }

    function saveCRM() {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(leads.map(l => ({
            id: l.id,
            status_crm: l.status_crm,
            notas: l.notas
        }))));
        updatePipelineCounts();
    }

    function updateLeadStatus(id, newStatus) {
        const lead = leads.find(l => l.id === id);
        if (lead) {
            lead.status_crm = newStatus;
            saveCRM();
            renderViews();
        }
    }

    function updateLeadNotes(id, text) {
        const lead = leads.find(l => l.id === id);
        if (lead) {
            lead.notas = text;
            saveCRM();
        }
    }

    function updatePipelineCounts() {
        const counts = {
            'Novo Lead': 0,
            'Mensagem Enviada': 0,
            'Diagnóstico Agendado': 0,
            'Proposta Apresentada': 0,
            'Fechado (Ganho)': 0,
            'Sem Interesse': 0
        };
        leads.forEach(l => {
            if (counts[l.status_crm] !== undefined) {
                counts[l.status_crm]++;
            } else {
                counts['Novo Lead']++;
            }
        });
        document.getElementById('count_novo').innerText = counts['Novo Lead'];
        document.getElementById('count_contato').innerText = counts['Mensagem Enviada'];
        document.getElementById('count_reuniao').innerText = counts['Diagnóstico Agendado'];
        document.getElementById('count_proposta').innerText = counts['Proposta Apresentada'];
        document.getElementById('count_fechado').innerText = counts['Fechado (Ganho)'];
        document.getElementById('count_perdido').innerText = counts['Sem Interesse'];

        // Kanban counts
        document.getElementById('k_count_novo').innerText = counts['Novo Lead'];
        document.getElementById('k_count_contato').innerText = counts['Mensagem Enviada'];
        document.getElementById('k_count_reuniao').innerText = counts['Diagnóstico Agendado'];
        document.getElementById('k_count_proposta').innerText = counts['Proposta Apresentada'];
        document.getElementById('k_count_fechado').innerText = counts['Fechado (Ganho)'];
        document.getElementById('k_count_perdido').innerText = counts['Sem Interesse'];
    }

    function filterCategory(cat) {
        currentCategory = cat;
        currentStatusFilter = 'todos';
        document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
        event.target.classList.add('active');
        document.querySelectorAll('.pipeline-card').forEach(c => c.classList.remove('active'));
        renderViews();
    }

    function filterStatus(status) {
        currentStatusFilter = status;
        document.querySelectorAll('.pipeline-card').forEach(c => c.classList.remove('active'));
        event.currentTarget.classList.add('active');
        renderViews();
    }

    function switchView(view) {
        currentView = view;
        if (view === 'table') {
            document.getElementById('tableView').style.display = 'block';
            document.getElementById('kanbanView').style.display = 'none';
            document.getElementById('btnTableView').classList.add('active');
            document.getElementById('btnKanbanView').classList.remove('active');
        } else {
            document.getElementById('tableView').style.display = 'none';
            document.getElementById('kanbanView').style.display = 'grid';
            document.getElementById('btnTableView').classList.remove('active');
            document.getElementById('btnKanbanView').classList.add('active');
        }
        renderViews();
    }

    function renderViews() {
        updatePipelineCounts();
        const searchVal = document.getElementById('searchInput').value.toLowerCase();

        const filtered = leads.filter(l => {
            const matchCat = currentCategory === 'todos' || l.categoria.includes(currentCategory);
            const matchStatus = currentStatusFilter === 'todos' || l.status_crm === currentStatusFilter;
            const matchSearch = l.nome.toLowerCase().includes(searchVal) ||
                                l.cidade_bairro.toLowerCase().includes(searchVal) ||
                                l.telefone_whatsapp.toLowerCase().includes(searchVal) ||
                                (l.notas && l.notas.toLowerCase().includes(searchVal)) ||
                                l.gargalo_critico.toLowerCase().includes(searchVal);
            return matchCat && matchStatus && matchSearch;
        });

        // Render Table
        const tbody = document.getElementById('leadsTableBody');
        tbody.innerHTML = '';

        filtered.forEach((lead) => {
            const tr = document.createElement('tr');
            
            const prioClass = lead.prioridade_comercial === 'Crítica' ? 'badge-prio-critica' : 
                             (lead.prioridade_comercial === 'Alta' ? 'badge-prio-alta' : 'badge-prio-media');

            const encodedMsg = encodeURIComponent(lead.script_abordagem);
            const waUrl = `https://wa.me/${lead.whatsapp_raw}?text=${encodedMsg}`;

            tr.innerHTML = `
                <td>
                    <select class="status-select" onchange="updateLeadStatus('${lead.id}', this.value)">
                        <option value="Novo Lead" ${lead.status_crm === 'Novo Lead' ? 'selected' : ''}>⚪ Novo Lead</option>
                        <option value="Mensagem Enviada" ${lead.status_crm === 'Mensagem Enviada' ? 'selected' : ''}>🔵 Msg Enviada</option>
                        <option value="Diagnóstico Agendado" ${lead.status_crm === 'Diagnóstico Agendado' ? 'selected' : ''}>🟡 Diag. Agendado</option>
                        <option value="Proposta Apresentada" ${lead.status_crm === 'Proposta Apresentada' ? 'selected' : ''}>🟣 Proposta</option>
                        <option value="Fechado (Ganho)" ${lead.status_crm === 'Fechado (Ganho)' ? 'selected' : ''}>🟢 Fechado 🏆</option>
                        <option value="Sem Interesse" ${lead.status_crm === 'Sem Interesse' ? 'selected' : ''}>🔴 Sem Interesse</option>
                    </select>
                    <div style="margin-top: 8px;">
                        <span class="badge ${prioClass}">${lead.prioridade_comercial}</span>
                    </div>
                </td>
                <td>
                    <div class="lead-title">${lead.nome}</div>
                    <div class="lead-sub">📍 ${lead.cidade_bairro}</div>
                    <div style="font-size: 11px; color: #718096; margin-top: 3px;">${lead.endereco}</div>
                    <div style="margin-top: 6px;">
                        <span class="badge badge-cat">${lead.categoria.split('(')[0].trim()}</span>
                    </div>
                </td>
                <td>
                    <div class="action-cluster">
                        <a href="${lead.maps_link}" target="_blank" class="btn-action btn-maps" title="Abrir localização e ficha no Google Maps">
                            🗺️ Google Maps
                        </a>
                        <a href="${waUrl}" target="_blank" class="btn-action btn-wa" title="Abrir conversa no WhatsApp com o script pré-carregado">
                            💬 WhatsApp Web
                        </a>
                        <button class="btn-action btn-copy-script" onclick="copyScriptText('${lead.id}')">
                            📋 Copiar Script
                        </button>
                        ${lead.site.startsWith('http') ? `<a href="${lead.site}" target="_blank" style="font-size:11px; color:#1d4e89; text-decoration:none; margin-top:2px;">🌐 Visitar Site</a>` : ''}
                    </div>
                </td>
                <td>
                    <div style="color: #9b2335; font-weight: 600; font-size: 12px; margin-bottom: 4px;">
                        ⚠️ ${lead.gargalo_critico}
                    </div>
                    <div style="color: var(--color-primary); font-size: 12px; font-weight: 600; margin-bottom: 4px;">
                        💡 ${lead.diagnostico_pilares}
                    </div>
                    <div style="font-size: 11px; color: #64748b;">
                        ${lead.presenca_digital}
                    </div>
                </td>
                <td>
                    <div style="font-weight: 700; color: var(--color-positive); font-size: 13px;">
                        ${lead.ticket_medio_est}
                    </div>
                    <div style="font-size: 11px; color: #64748b; margin-top: 4px;">
                        ${lead.argumento_roi}
                    </div>
                </td>
                <td>
                    <textarea class="notes-area" placeholder="Ex: Chamei no WhatsApp em 03/09, secretária pediu para retornar às 15h..." onchange="updateLeadNotes('${lead.id}', this.value)">${lead.notas || ''}</textarea>
                </td>
            `;
            tbody.appendChild(tr);
        });

        // Render Kanban
        const kanbanContainers = {
            'Novo Lead': document.getElementById('k_cards_novo'),
            'Mensagem Enviada': document.getElementById('k_cards_contato'),
            'Diagnóstico Agendado': document.getElementById('k_cards_reuniao'),
            'Proposta Apresentada': document.getElementById('k_cards_proposta'),
            'Fechado (Ganho)': document.getElementById('k_cards_fechado'),
            'Sem Interesse': document.getElementById('k_cards_perdido')
        };

        Object.values(kanbanContainers).forEach(c => c.innerHTML = '');

        filtered.forEach(lead => {
            const targetCol = kanbanContainers[lead.status_crm] || kanbanContainers['Novo Lead'];
            const card = document.createElement('div');
            card.className = 'kanban-card';
            card.innerHTML = `
                <div class="k-title">${lead.nome}</div>
                <div style="font-size: 11px; color: #64748b;">📍 ${lead.cidade_bairro}</div>
                <div style="font-size: 11px; font-weight: 700; color: var(--color-positive);">${lead.ticket_medio_est}</div>
                <div style="display:flex; gap: 4px; margin-top: 4px;">
                    <a href="${lead.maps_link}" target="_blank" class="btn-action btn-maps" style="padding:3px 6px; font-size:10px;">Maps</a>
                    <a href="https://wa.me/${lead.whatsapp_raw}?text=${encodeURIComponent(lead.script_abordagem)}" target="_blank" class="btn-action btn-wa" style="padding:3px 6px; font-size:10px;">WhatsApp</a>
                </div>
                <select class="status-select" style="width: 100%; margin-top: 6px; font-size: 11px; padding: 4px;" onchange="updateLeadStatus('${lead.id}', this.value)">
                    <option value="Novo Lead" ${lead.status_crm === 'Novo Lead' ? 'selected' : ''}>Novo Lead</option>
                    <option value="Mensagem Enviada" ${lead.status_crm === 'Mensagem Enviada' ? 'selected' : ''}>Msg Enviada</option>
                    <option value="Diagnóstico Agendado" ${lead.status_crm === 'Diagnóstico Agendado' ? 'selected' : ''}>Diag. Agendado</option>
                    <option value="Proposta Apresentada" ${lead.status_crm === 'Proposta Apresentada' ? 'selected' : ''}>Proposta</option>
                    <option value="Fechado (Ganho)" ${lead.status_crm === 'Fechado (Ganho)' ? 'selected' : ''}>Fechado 🏆</option>
                    <option value="Sem Interesse" ${lead.status_crm === 'Sem Interesse' ? 'selected' : ''}>Sem Interesse</option>
                </select>
            `;
            targetCol.appendChild(card);
        });
    }

    function copyScriptText(id) {
        const lead = leads.find(l => l.id === id);
        if (lead) {
            navigator.clipboard.writeText(lead.script_abordagem).then(() => {
                alert(`Script copiado para ${lead.nome}!

"${lead.script_abordagem}"`);
            });
        }
    }

    function exportUpdatedCSV() {
        const headers = [
            "ID", "Nome da Empresa", "Status CRM Funil", "Categoria / Nicho", "Cidade / Bairro", 
            "Endereço Físico", "Telefone / WhatsApp", "Link Google Maps", "E-mail de Contato", 
            "Site Atual", "Gargalo Crítico", "Pilares Recomendados", "Ticket Médio", "ROI", 
            "Prioridade", "Script WhatsApp", "Notas / Observações Comerciais"
        ];
        
        let csvContent = "\uFEFF" + headers.join(";") + "\n";
        
        leads.forEach(l => {
            const row = [
                l.id,
                `"${l.nome.replace(/"/g, '""')}"`,
                `"${(l.status_crm || '').replace(/"/g, '""')}"`,
                `"${l.categoria.replace(/"/g, '""')}"`,
                `"${l.cidade_bairro.replace(/"/g, '""')}"`,
                `"${l.endereco.replace(/"/g, '""')}"`,
                `"${l.telefone_whatsapp.replace(/"/g, '""')}"`,
                `"${l.maps_link.replace(/"/g, '""')}"`,
                `"${l.email.replace(/"/g, '""')}"`,
                `"${l.site.replace(/"/g, '""')}"`,
                `"${l.gargalo_critico.replace(/"/g, '""')}"`,
                `"${l.diagnostico_pilares.replace(/"/g, '""')}"`,
                `"${l.ticket_medio_est.replace(/"/g, '""')}"`,
                `"${l.argumento_roi.replace(/"/g, '""')}"`,
                `"${l.prioridade_comercial.replace(/"/g, '""')}"`,
                `"${l.script_abordagem.replace(/"/g, '""')}"`,
                `"${(l.notas || '').replace(/"/g, '""')}"`
            ];
            csvContent += row.join(";") + "\n";
        });

        const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
        const url = URL.createObjectURL(blob);
        const link = document.createElement("a");
        link.setAttribute("href", url);
        link.setAttribute("download", `CRM_Marcenarias_Sorocaba_Atualizado_${new Date().toISOString().slice(0,10)}.csv`);
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
    }

    function resetCRMData() {
        currentCategory = 'todos';
        currentStatusFilter = 'todos';
        document.getElementById('searchInput').value = '';
        document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
        document.getElementById('btn_all').classList.add('active');
        document.querySelectorAll('.pipeline-card').forEach(c => c.classList.remove('active'));
        renderViews();
    }

    window.onload = initCRM;
</script>
</body>
</html>
