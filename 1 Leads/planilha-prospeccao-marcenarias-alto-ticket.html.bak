<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CRM Prospecção Alto Ticket — Marcenarias & Planejados Sorocaba e Região | Vocação</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&family=Montserrat:wght@400;500;600;700&family=Geist+Mono:wght@400;500&display=swap" rel="stylesheet">
    <style>
        :root {
            --color-accent: #E5B910;
            --color-accent-soft: #fcf9eb;
            --color-primary: #061B28;
            --color-bg: #fafaf8;
            --color-surface: #ffffff;
            --color-text: #1a1a1a;
            --color-text-muted: #5a625f;
            --color-border: #e2e8e5;
            --color-positive: #0B5E47;
            --color-negative: #9b2335;
            --color-opportunity: #1d4e89;
            --color-warning: #c17f24;
            
            /* Status CRM colors */
            --status-novo: #64748b;
            --status-contato: #0284c7;
            --status-reuniao: #d97706;
            --status-proposta: #7c3aed;
            --status-fechado: #059669;
            --status-perdido: #dc2626;
        }
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }
        body {
            font-family: 'Montserrat', sans-serif;
            background-color: var(--color-bg);
            color: var(--color-text);
            line-height: 1.5;
            padding: 24px 16px;
        }
        .container {
            max-width: 1560px;
            margin: 0 auto;
        }
        header.vocacao-header {
            background: linear-gradient(135deg, #061B28 0%, #0c2b3f 100%);
            color: #ffffff;
            padding: 28px 36px;
            border-radius: 14px;
            border-bottom: 4px solid var(--color-accent);
            box-shadow: 0 10px 25px rgba(6, 27, 40, 0.15);
            margin-bottom: 24px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 20px;
        }
        .header-left h1 {
            font-family: 'Poppins', sans-serif;
            font-size: 24px;
            font-weight: 700;
            color: #ffffff;
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 6px;
        }
        .header-left p {
            font-size: 13.5px;
            color: #c9d8d5;
            max-width: 820px;
        }
        .badge-vocacao {
            background-color: rgba(229, 185, 16, 0.15);
            color: var(--color-accent);
            border: 1px solid var(--color-accent);
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.8px;
            font-family: 'Geist Mono', monospace;
            display: inline-block;
            margin-bottom: 8px;
        }
        .header-actions {
            display: flex;
            gap: 12px;
            align-items: center;
            flex-wrap: wrap;
        }
        .btn-header {
            padding: 9px 16px;
            border-radius: 8px;
            font-weight: 700;
            text-decoration: none;
            font-size: 13px;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            cursor: pointer;
            border: none;
            transition: all 0.2s ease;
        }
        .btn-accent {
            background-color: var(--color-accent);
            color: var(--color-primary);
        }
        .btn-accent:hover {
            background-color: #ffd026;
            transform: translateY(-2px);
        }
        .btn-outline {
            background-color: transparent;
            color: #ffffff;
            border: 1px solid rgba(255,255,255,0.3);
        }
        .btn-outline:hover {
            background-color: rgba(255,255,255,0.1);
            border-color: #ffffff;
        }

        /* Pipeline Counter Bar */
        .pipeline-bar {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
            gap: 12px;
            margin-bottom: 24px;
        }
        .pipeline-card {
            background: var(--color-surface);
            border: 1px solid var(--color-border);
            border-radius: 10px;
            padding: 14px 18px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            box-shadow: 0 2px 8px rgba(0,0,0,0.02);
            cursor: pointer;
            transition: all 0.2s ease;
            position: relative;
            overflow: hidden;
        }
        .pipeline-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 14px rgba(0,0,0,0.06);
        }
        .pipeline-card.active {
            border-color: var(--color-accent);
            box-shadow: 0 0 0 2px var(--color-accent);
        }
        .pipeline-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 4px;
            height: 100%;
        }
        .pipeline-card.novo::before { background: var(--status-novo); }
        .pipeline-card.contato::before { background: var(--status-contato); }
        .pipeline-card.reuniao::before { background: var(--status-reuniao); }
        .pipeline-card.proposta::before { background: var(--status-proposta); }
        .pipeline-card.fechado::before { background: var(--status-fechado); }
        .pipeline-card.perdido::before { background: var(--status-perdido); }

        .pipeline-card .stage-name {
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            color: var(--color-text-muted);
            letter-spacing: 0.5px;
        }
        .pipeline-card .stage-count {
            font-family: 'Poppins', sans-serif;
            font-size: 22px;
            font-weight: 700;
            color: var(--color-primary);
            margin-top: 4px;
        }

        /* Filtros & Barra de Ferramentas */
        .controls-card {
            background: var(--color-surface);
            border: 1px solid var(--color-border);
            border-radius: 12px;
            padding: 16px 20px;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            flex-wrap: wrap;
        }
        .filter-group {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
            align-items: center;
        }
        .filter-btn {
            background: #f1f5f4;
            border: 1px solid transparent;
            padding: 7px 14px;
            border-radius: 8px;
            font-size: 12.5px;
            font-weight: 600;
            color: var(--color-primary);
            cursor: pointer;
            transition: all 0.2s;
        }
        .filter-btn.active, .filter-btn:hover {
            background: var(--color-primary);
            color: #ffffff;
        }
        .search-box {
            flex: 1;
            min-width: 280px;
            position: relative;
        }
        .search-box input {
            width: 100%;
            padding: 9px 14px;
            border: 1px solid var(--color-border);
            border-radius: 8px;
            font-size: 13px;
            font-family: inherit;
        }
        .search-box input:focus {
            outline: none;
            border-color: var(--color-accent);
            box-shadow: 0 0 0 3px rgba(229, 185, 16, 0.2);
        }
        .view-toggle {
            display: flex;
            gap: 6px;
            background: #f1f5f4;
            padding: 4px;
            border-radius: 8px;
        }
        .view-btn {
            border: none;
            background: transparent;
            padding: 6px 12px;
            border-radius: 6px;
            font-size: 12px;
            font-weight: 600;
            cursor: pointer;
            color: var(--color-primary);
        }
        .view-btn.active {
            background: var(--color-surface);
            box-shadow: 0 2px 5px rgba(0,0,0,0.06);
        }

        /* TABELA CRM */
        .table-wrapper {
            background: var(--color-surface);
            border: 1px solid var(--color-border);
            border-radius: 12px;
            overflow-x: auto;
            box-shadow: 0 4px 16px rgba(0,0,0,0.03);
            margin-bottom: 30px;
        }
        table.crm-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 13px;
            min-width: 1200px;
        }
        table.crm-table th {
            background-color: #0c2333;
            color: #ffffff;
            font-family: 'Poppins', sans-serif;
            font-weight: 600;
            padding: 12px 14px;
            font-size: 11.5px;
            text-transform: uppercase;
            letter-spacing: 0.6px;
            border-bottom: 2px solid var(--color-accent);
            white-space: nowrap;
        }
        table.crm-table td {
            padding: 12px 14px;
            border-bottom: 1px solid var(--color-border);
            vertical-align: top;
        }
        table.crm-table tr:hover td {
            background-color: #f8faf9;
        }

        .lead-title {
            font-family: 'Poppins', sans-serif;
            font-weight: 600;
            font-size: 14px;
            color: var(--color-primary);
            margin-bottom: 3px;
        }
        .lead-sub {
            font-size: 11.5px;
            color: var(--color-text-muted);
        }

        /* Links & Ações */
        .action-cluster {
            display: flex;
            flex-direction: column;
            gap: 6px;
            min-width: 140px;
        }
        .btn-action {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            padding: 6px 10px;
            border-radius: 6px;
            font-size: 11.5px;
            font-weight: 600;
            text-decoration: none;
            cursor: pointer;
            border: 1px solid transparent;
            transition: all 0.2s;
        }
        .btn-maps {
            background-color: #f0fdf4;
            color: #166534;
            border-color: #bbf7d0;
        }
        .btn-maps:hover {
            background-color: #dcfce7;
        }
        .btn-wa {
            background-color: #25D366;
            color: #ffffff;
        }
        .btn-wa:hover {
            background-color: #1eb857;
            transform: translateY(-1px);
        }
        .btn-copy-script {
            background-color: #f1f5f9;
            color: #334155;
            border-color: #cbd5e1;
        }
        .btn-copy-script:hover {
            background-color: var(--color-accent);
            color: var(--color-primary);
        }

        /* Badges */
        .badge {
            display: inline-block;
            padding: 3px 8px;
            border-radius: 4px;
            font-size: 10.5px;
            font-weight: 700;
            letter-spacing: 0.3px;
        }
        .badge-cat {
            background: #eef4fc;
            color: #1a4d8c;
            border: 1px solid #c9defa;
            font-family: 'Geist Mono', monospace;
        }
        .badge-prio-critica { background: #fde8e8; color: #9b2335; border: 1px solid #f8b4b4; }
        .badge-prio-alta { background: #fef3c7; color: #92400e; border: 1px solid #fde68a; }
        .badge-prio-media { background: #e0f2fe; color: #075985; border: 1px solid #bae6fd; }

        /* Status Dropdown */
        .status-select {
            padding: 6px 10px;
            border-radius: 6px;
            font-size: 12px;
            font-weight: 600;
            border: 1px solid var(--color-border);
            cursor: pointer;
            background-color: #ffffff;
            font-family: inherit;
        }
        .status-select:focus {
            outline: none;
            border-color: var(--color-accent);
        }

        /* Anotações no Lead */
        .notes-area {
            width: 100%;
            min-height: 50px;
            padding: 6px 8px;
            font-size: 11.5px;
            font-family: inherit;
            border: 1px solid var(--color-border);
            border-radius: 6px;
            resize: vertical;
            background: #fdfdfd;
        }
        .notes-area:focus {
            outline: none;
            border-color: var(--color-accent);
            background: #ffffff;
        }

        /* Visualização Kanban */
        .kanban-board {
            display: none;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 16px;
            margin-bottom: 30px;
            overflow-x: auto;
        }
        .kanban-col {
            background: #f4f6f5;
            border: 1px solid var(--color-border);
            border-radius: 10px;
            padding: 14px;
            min-height: 500px;
            display: flex;
            flex-direction: column;
            gap: 12px;
        }
        .kanban-col-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding-bottom: 8px;
            border-bottom: 2px solid var(--color-border);
            font-family: 'Poppins', sans-serif;
            font-size: 13px;
            font-weight: 700;
            color: var(--color-primary);
        }
        .kanban-card {
            background: #ffffff;
            border: 1px solid var(--color-border);
            border-radius: 8px;
            padding: 12px;
            box-shadow: 0 2px 6px rgba(0,0,0,0.03);
            display: flex;
            flex-direction: column;
            gap: 8px;
        }
        .kanban-card .k-title {
            font-weight: 600;
            font-size: 13px;
            color: var(--color-primary);
        }

        footer.vocacao-footer {
            text-align: center;
            font-size: 12.5px;
            color: var(--color-text-muted);
            padding: 24px 0 12px 0;
            border-top: 1px solid var(--color-border);
        }
    </style>
</head>
<body>
<div class="container">
    <header class="vocacao-header">
        <div class="header-left">
            <div class="badge-vocacao">CRM de Prospecção & Inteligência Comercial Vocação</div>
            <h1>
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 4001.88 3715.4" width="26" height="26" fill="none">
                    <path d="M45.03 0.01l1213.22 0 1387.23 2638.86c-277.85,525.48 -495.08,935.8 -517.87,978.08 -64.91,120.45 -134.89,140.51 -212.88,3.18 -632.47,-1181.24 -1264.91,-2362.48 -1897.38,-3543.73 -28.66,-49.03 -23.4,-76.94 27.68,-76.4zm2311.4 0l1578.29 0c66.2,0 95.98,9.39 30.56,136.59 -56.81,110.47 -396.78,755.17 -769.29,1460.51l-839.57 -1597.1z" fill="#ffffff" />
                    <rect transform="matrix(0.395693 0.564385 -1.12875 0.791372 3191.31 348.346)" width="275.97" height="1545.42" rx="154.54" ry="154.54" fill="#061B28" />
                </svg>
                CRM Alto Ticket: Marcenarias & Planejados (Sorocaba e Região)
            </h1>
            <p>Acompanhamento de funil, links diretos do Google Maps, disparo instantâneo no WhatsApp e persistência de anotações comerciais.</p>
        </div>
        <div class="header-actions">
            <button class="btn-header btn-accent" onclick="exportUpdatedCSV()">
                <svg width="15" height="15" fill="currentColor" viewBox="0 0 16 16"><path d="M.5 9.9a.5.5 0 0 1 .5.5v2.5a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-2.5a.5.5 0 0 1 1 0v2.5a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2v-2.5a.5.5 0 0 1 .5-.5z"/><path d="M7.646 11.854a.5.5 0 0 0 .708 0l3-3a.5.5 0 0 0-.708-.708L8.5 10.293V1.5a.5.5 0 0 0-1 0v8.793L5.354 8.146a.5.5 0 1 0-.708.708l3 3z"/></svg>
                Exportar CSV do CRM
            </button>
            <button class="btn-header btn-outline" onclick="resetCRMData()">
                Resetar Filtros
            </button>
        </div>
    </header>

    <!-- Pipeline Stages Stats -->
    <div class="pipeline-bar">
        <div class="pipeline-card novo" onclick="filterStatus('Novo Lead')">
            <div class="stage-name">1. Novo Lead</div>
            <div class="stage-count" id="count_novo">0</div>
        </div>
        <div class="pipeline-card contato" onclick="filterStatus('Mensagem Enviada')">
            <div class="stage-name">2. Mensagem Enviada</div>
            <div class="stage-count" id="count_contato">0</div>
        </div>
        <div class="pipeline-card reuniao" onclick="filterStatus('Diagnóstico Agendado')">
            <div class="stage-name">3. Diagnóstico Agendado</div>
            <div class="stage-count" id="count_reuniao">0</div>
        </div>
        <div class="pipeline-card proposta" onclick="filterStatus('Proposta Apresentada')">
            <div class="stage-name">4. Proposta Apresentada</div>
            <div class="stage-count" id="count_proposta">0</div>
        </div>
        <div class="pipeline-card fechado" onclick="filterStatus('Fechado (Ganho)')">
            <div class="stage-name">5. Fechado (Ganho 🏆)</div>
            <div class="stage-count" id="count_fechado">0</div>
        </div>
        <div class="pipeline-card perdido" onclick="filterStatus('Sem Interesse')">
            <div class="stage-name">6. Sem Interesse</div>
            <div class="stage-count" id="count_perdido">0</div>
        </div>
    </div>

    <!-- Barra de Controles e Filtros -->
    <div class="controls-card">
        <div class="filter-group">
            <button class="filter-btn active" id="btn_all" onclick="filterCategory('todos')">Todos (20)</button>
            <button class="filter-btn" onclick="filterCategory('Marcenaria Autoral')">🪵 Marcenarias (10)</button>
            <button class="filter-btn" onclick="filterCategory('Lojas & Estúdios')">🛋️ Lojas & Showrooms (6)</button>
            <button class="filter-btn" onclick="filterCategory('Marmorarias')">🏛️ Marmorarias (4)</button>
        </div>
        <div class="search-box">
            <input type="text" id="searchInput" placeholder="Pesquisar por nome, bairro, telefone ou nota..." onkeyup="renderViews()">
        </div>
        <div class="view-toggle">
            <button class="view-btn active" id="btnTableView" onclick="switchView('table')">📋 Tabela</button>
            <button class="view-btn" id="btnKanbanView" onclick="switchView('kanban')">📊 Kanban</button>
        </div>
    </div>

    <!-- VISUALIZAÇÃO TABELA CRM -->
    <div class="table-wrapper" id="tableView">
        <table class="crm-table">
            <thead>
                <tr>
                    <th style="width: 140px;">Status do Funil</th>
                    <th style="width: 220px;">Lead & Localização</th>
                    <th style="width: 170px;">Conferência & Ações Rápidas</th>
                    <th style="width: 260px;">Gargalo de Autoridade & Diagnóstico</th>
                    <th style="width: 140px;">Ticket & ROI</th>
                    <th>Notas Comerciais (Salvas Automático)</th>
                </tr>
            </thead>
            <tbody id="leadsTableBody">
                <!-- Linhas renderizadas dinamicamente via JS com persistência de dados -->
            </tbody>
        </table>
    </div>

    <!-- VISUALIZAÇÃO KANBAN CRM -->
    <div class="kanban-board" id="kanbanView">
        <div class="kanban-col" data-status="Novo Lead">
            <div class="kanban-col-header">
                <span>Novo Lead</span>
                <span class="badge" id="k_count_novo">0</span>
            </div>
            <div class="kanban-cards" id="k_cards_novo"></div>
        </div>
        <div class="kanban-col" data-status="Mensagem Enviada">
            <div class="kanban-col-header">
                <span>Mensagem Enviada</span>
                <span class="badge" id="k_count_contato">0</span>
            </div>
            <div class="kanban-cards" id="k_cards_contato"></div>
        </div>
        <div class="kanban-col" data-status="Diagnóstico Agendado">
            <div class="kanban-col-header">
                <span>Diagnóstico Agendado</span>
                <span class="badge" id="k_count_reuniao">0</span>
            </div>
            <div class="kanban-cards" id="k_cards_reuniao"></div>
        </div>
        <div class="kanban-col" data-status="Proposta Apresentada">
            <div class="kanban-col-header">
                <span>Proposta Apresentada</span>
                <span class="badge" id="k_count_proposta">0</span>
            </div>
            <div class="kanban-cards" id="k_cards_proposta"></div>
        </div>
        <div class="kanban-col" data-status="Fechado (Ganho)">
            <div class="kanban-col-header">
                <span>Fechado (Ganho 🏆)</span>
                <span class="badge" id="k_count_fechado">0</span>
            </div>
            <div class="kanban-cards" id="k_cards_fechado"></div>
        </div>
        <div class="kanban-col" data-status="Sem Interesse">
            <div class="kanban-col-header">
                <span>Sem Interesse</span>
                <span class="badge" id="k_count_perdido">0</span>
            </div>
            <div class="kanban-cards" id="k_cards_perdido"></div>
        </div>
    </div>

    <footer class="vocacao-footer">
        <p><strong>Vocação Comunicação & Marketing</strong> • Infraestrutura de Autoridade para Negócios de Alto Ticket</p>
        <p style="margin-top: 4px;">WhatsApp Comercial Vocação: (15) 98151-2083 | Sorocaba - SP | vocacao.digital</p>
    </footer>
</div>

<script>
